# Copie ce fichier en .env pour tester en local. En ligne, la clé va dans les « secrets » du dépôt GitHub
# (Settings > Secrets and variables > Actions). Tout est optionnel : Prisme marche sans.

# Résumé neutre des grandes histoires (une seule des deux suffit)
#  - Gemini, palier gratuit : https://aistudio.google.com/apikey
#    (Flash-Lite par défaut : environ 500 résumés gratuits par jour ; laisse GEMINI_MODEL vide)
GEMINI_API_KEY=
GEMINI_MODEL=
#  - Claude, payant à l'usage (environ 1 cent par résumé) : https://platform.claude.com
ANTHROPIC_API_KEY=
